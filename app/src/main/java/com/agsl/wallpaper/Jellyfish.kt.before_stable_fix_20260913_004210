package com.agsl.wallpaper

import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.view.MotionEvent
import kotlin.math.*
import kotlin.random.Random


// ============================================================
// 基础单体
// ============================================================

abstract class AbyssalOrganism(
    var x: Float,
    var y: Float,

    val scaleFactor: Float,

    val speciesId: Int,

    val rgb: IntArray,

    var driftVx: Float,
    var driftVy: Float,

    var t: Float
) {

    companion object {
        const val POINT_COUNT = 2600
    }

    val pts =
        FloatArray(
            POINT_COUNT * 2
        )

    var isOffscreen = false

    // --------------------------------------------------------
    // 每只自己的点击加速
    // --------------------------------------------------------

    var startlePulse = 0f

    // --------------------------------------------------------
    // 每只自己的年龄 / 漂移相位
    // --------------------------------------------------------

    private var age =
        Random.nextFloat() * 100f

    private val driftPhase =
        Random.nextFloat() * 100f

    private val driftStrength =
        Random.nextFloat() * 0.45f + 0.65f

    protected val paint =
        Paint(
            Paint.ANTI_ALIAS_FLAG
        ).apply {
            strokeCap =
                Paint.Cap.ROUND
        }


    abstract fun evaluateShape(
        currentScale: Float,
        touchX: Float,
        touchY: Float,
        touchDown: Boolean
    ): Int


    // ========================================================
    // 命中检测
    // ========================================================

    open fun hitRadius(
        baseScale: Float
    ): Float {

        return (
            118f *
            scaleFactor *
            baseScale
        ).coerceAtLeast(
            38f
        )
    }


    fun checkAndApplyImpulse(
        tx: Float,
        ty: Float,
        baseScale: Float
    ): Boolean {

        val dx =
            tx - x

        val dy =
            ty - y

        val r =
            hitRadius(baseScale)

        val dist2 =
            dx * dx +
            dy * dy

        if (
            dist2 <=
            r * r
        ) {

            // 只修改这一只
            startlePulse =
                (
                    startlePulse +
                    1.35f
                ).coerceAtMost(
                    2.25f
                )

            return true
        }

        return false
    }


    // ========================================================
    // 旧版稳定运动机制
    //
    // 这里故意不设置“屏幕内部墙”
    //
    // 水母允许自然游出屏幕。
    // 只有整个形体离开足够大的外围后才回收。
    // ========================================================

    fun update(
        w: Float,
        h: Float,
        baseScale: Float
    ) {

        age +=
            0.016f


        // ----------------------------------------------------
        // 非常轻微的自然漂移
        // ----------------------------------------------------

        val wanderX =
            sin(
                age * 0.37f +
                driftPhase
            ) *
            0.0018f *
            driftStrength

        val wanderY =
            cos(
                age * 0.31f +
                driftPhase * 0.7f
            ) *
            0.0016f *
            driftStrength


        driftVx +=
            wanderX

        driftVy +=
            wanderY


        // ----------------------------------------------------
        // 点击后只有当前对象加速
        // ----------------------------------------------------

        val motionBoost =
            1f +
            startlePulse *
            0.72f


        x +=
            driftVx *
            motionBoost

        y +=
            driftVy *
            motionBoost


        // ----------------------------------------------------
        // 非常保守的速度限制
        // ----------------------------------------------------

        val maxSpeed =
            0.42f +
            (
                1f -
                scaleFactor
            ) *
            0.08f

        driftVx =
            driftVx.coerceIn(
                -maxSpeed,
                maxSpeed
            )

        driftVy =
            driftVy.coerceIn(
                -maxSpeed,
                maxSpeed
            )


        // ----------------------------------------------------
        // 自己的动画时间
        // ----------------------------------------------------

        t +=
            0.010f +
            startlePulse *
            0.004f


        // ----------------------------------------------------
        // 自己的加速衰减
        // ----------------------------------------------------

        startlePulse *=
            0.932f


        // ====================================================
        // 关键：
        //
        // 不设置任何“墙”
        //
        // 不会出现：
        //
        //   if (x < minX) x = minX
        //   if (x > maxX) x = maxX
        //
        // 所以不会被卡在某条隐形边界上。
        // ====================================================

        val margin =
            (
                260f *
                scaleFactor *
                baseScale
            ).coerceAtLeast(
                170f
            )


        if (
            !x.isFinite() ||
            !y.isFinite() ||
            !driftVx.isFinite() ||
            !driftVy.isFinite() ||
            !t.isFinite()
        ) {

            isOffscreen = true

            return
        }


        // ----------------------------------------------------
        // 只有整个生物真正离开外围才删除
        // ----------------------------------------------------

        isOffscreen =
            y <
                -margin ||
            x <
                -margin ||
            x >
                w + margin ||
            y >
                h + margin * 1.35f
    }


    // ========================================================
    // 绘制
    // ========================================================

    fun draw(
        canvas: Canvas,
        baseScale: Float,
        touchX: Float,
        touchY: Float,
        touchDown: Boolean
    ) {

        val currentScale =
            baseScale *
            scaleFactor


        // 旧版细点画质感
        paint.strokeWidth =
            (
                1.65f +
                0.42f *
                scaleFactor
            )


        // 点击时自己变亮
        val alpha =
            (
                72f +
                startlePulse *
                72f
            )
                .coerceIn(
                    55f,
                    185f
                )
                .toInt()


        paint.color =
            Color.argb(
                alpha,
                rgb[0],
                rgb[1],
                rgb[2]
            )


        val validCount =
            evaluateShape(
                currentScale,
                touchX,
                touchY,
                touchDown
            )


        if (
            validCount <= 0
        ) {
            return
        }


        canvas.drawPoints(
            pts,
            0,
            min(
                validCount,
                POINT_COUNT
            ) * 2,
            paint
        )
    }


    // ========================================================
    // 点击产生局部水波
    //
    // 只传给被点击对象。
    // ========================================================

    protected fun displaceByWater(
        px: Float,
        py: Float,
        tx: Float,
        ty: Float,
        touchDown: Boolean
    ): Pair<Float, Float> {

        if (!touchDown) {
            return px to py
        }


        val dx =
            px - tx

        val dy =
            py - ty

        val d2 =
            dx * dx +
            dy * dy


        if (
            d2 <
            24000f &&
            d2 >
            1f
        ) {

            val d =
                sqrt(d2)

            val push =
                (
                    1f -
                    d / 155f
                ).coerceAtLeast(
                    0f
                ) *
                18f


            return (
                px +
                dx / d *
                push
            ) to (
                py +
                dy / d *
                push
            )
        }


        return px to py
    }
}


// ============================================================
// 物种 0
// Classic
//
// 原始公式保留。
// ============================================================

class ClassicJellyfish(
    x: Float,
    y: Float,
    sc: Float,
    rgb: IntArray,
    vx: Float,
    vy: Float,
    tInit: Float
) :
    AbyssalOrganism(
        x,
        y,
        sc,
        0,
        rgb,
        vx,
        vy,
        tInit
    ) {

    override fun evaluateShape(
        currentScale: Float,
        touchX: Float,
        touchY: Float,
        touchDown: Boolean
    ): Int {

        var ptr = 0

        val step =
            20000f /
            POINT_COUNT


        for (
            p in POINT_COUNT - 1 downTo 0
        ) {

            val i =
                p *
                step

            val yVal =
                i /
                99f

            val k =
                9f *
                cos(
                    yVal * 2f
                )

            val e =
                yVal /
                8f -
                12f

            val d =
                (
                    k * k +
                    e * e
                ) /
                79f +
                1f

            val q =
                79f -
                e *
                sin(k) +
                (
                    k / d
                ) *
                (
                    8f +
                    4f *
                    sin(
                        sin(
                            d * d +
                            e / 9f -
                            t
                        )
                    )
                )

            val c =
                d / 2f -
                cos(
                    d * 2f
                ) / 5f -
                t / 16f


            val rx =
                q *
                sin(c) *
                currentScale

            val ry =
                (
                    q +
                    40f
                ) *
                cos(c) *
                currentScale


            val point =
                displaceByWater(
                    x + rx,
                    y + ry,
                    touchX,
                    touchY,
                    touchDown
                )


            pts[ptr++] =
                point.first

            pts[ptr++] =
                point.second
        }


        return POINT_COUNT
    }
}


// ============================================================
// 物种 1
// Crown
// ============================================================

class CrownMedusa(
    x: Float,
    y: Float,
    sc: Float,
    rgb: IntArray,
    vx: Float,
    vy: Float,
    tInit: Float
) :
    AbyssalOrganism(
        x,
        y,
        sc,
        1,
        rgb,
        vx,
        vy,
        tInit
    ) {

    override fun evaluateShape(
        currentScale: Float,
        touchX: Float,
        touchY: Float,
        touchDown: Boolean
    ): Int {

        var ptr = 0

        val step =
            20000f /
            POINT_COUNT


        for (
            p in POINT_COUNT - 1 downTo 0
        ) {

            val i =
                p *
                step

            val yVal =
                i /
                110f

            val k =
                8f *
                cos(
                    if (
                        yVal < 59f
                    )
                        (i.toInt() % 9).toFloat()
                    else
                        i * 4f
                )

            val e =
                yVal /
                7f -
                16f

            val d =
                (
                    k * k +
                    e * e
                ) /
                89f +
                1.1f

            val q =
                k / d * 3f -
                e *
                sin(k) +
                (
                    k /
                    (d * 3f)
                ) *
                (
                    9f -
                    d *
                    4f *
                    sin(
                        d * d -
                        t +
                        sin(e) / 2f
                    )
                ) +
                70f

            val c =
                d /
                1.5f -
                t / 12f +
                (i.toInt() % 2) *
                3f


            val rx =
                q *
                sin(c) *
                currentScale

            val ry =
                (
                    q *
                    cos(c) +
                    e
                ) *
                currentScale


            val point =
                displaceByWater(
                    x + rx,
                    y + ry,
                    touchX,
                    touchY,
                    touchDown
                )


            pts[ptr++] =
                point.first

            pts[ptr++] =
                point.second
        }


        return POINT_COUNT
    }
}


